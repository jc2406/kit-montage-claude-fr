{
  "$schema": "../registry.schema.json",
  "id": "STYLE_ID",
  "name": "Nom lisible du style",
  "number": "NN",
  "status": "draft",
  "inspiration": "Sur quel créateur / quel look ce style s'appuie (par ex. Vox explainer). Les images de référence vont dans references/.",
  "summary": "Description en une ligne du ressenti et du moment où utiliser ce style.",
  "palette": {
    "bg": "#000000",
    "fg": "#ffffff",
    "accent": "#000000",
    "notes": "2 ou 3 couleurs maximum. À reporter dans tokens.css."
  },
  "fonts": {
    "display": "FontName",
    "body": "FontName",
    "mono": "FontName"
  },
  "motion": "Nerveux | fluide | dramatique — la signature de courbes (à reporter dans tokens.css --ease-*).",
  "transitions": "Quel ressenti d'entrée/sortie correspond à ce style.",
  "cards": [
    {
      "id": "STYLE_ID.t1.stat",
      "tier": "tier1",
      "purpose": "stat",
      "file": "cards/tier1/t1-stat.html",
      "slots": [
        {
          "name": "kicker",
          "type": "text",
          "maxChars": 30
        },
        {
          "name": "stat",
          "type": "text",
          "maxChars": 8
        },
        {
          "name": "label",
          "type": "text",
          "maxChars": 48
        }
      ],
      "duration": {
        "min": 5,
        "max": 8
      },
      "preview": {
        "mp4": "preview/STYLE_ID.t1.stat.mp4",
        "poster": "preview/STYLE_ID.t1.stat.png"
      }
    },
    {
      "id": "STYLE_ID.t2.list",
      "tier": "tier2",
      "purpose": "list",
      "file": "cards/tier2/t2-list.html",
      "slots": [
        {
          "name": "tag",
          "type": "text",
          "maxChars": 24
        },
        {
          "name": "headline",
          "type": "text",
          "maxChars": 48
        },
        {
          "name": "items",
          "type": "list",
          "maxItems": 4,
          "maxChars": 40
        }
      ],
      "duration": {
        "min": 12,
        "max": 30
      },
      "preview": {
        "mp4": "preview/STYLE_ID.t2.list.mp4",
        "poster": "preview/STYLE_ID.t2.list.png"
      }
    }
  ]
}
